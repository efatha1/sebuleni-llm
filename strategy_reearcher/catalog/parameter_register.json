{
  "_meta": {
    "title": "Parameter Register — every numeric / definitional parameter used by the strategy catalog, with its knowledge-base status",
    "status_legend": {
      "specified": "the knowledge base gives a definite value or rule",
      "specified_approx": "the knowledge base gives an approximate value ('~2-3')",
      "range_given": "the knowledge base gives a range and says the exact value is the trader's choice",
      "alternatives_documented": "the knowledge base documents two or more values/definitions without resolving them",
      "heuristic_unfixed": "the knowledge base reports a heuristic from secondary sources and explicitly declines to fix it",
      "unspecified": "the knowledge base does not give a value; the researcher must freeze one and report it as a research parameter (ADV-M18-C03), never as doctrine (ADV-M18-R01)"
    },
    "rule": "Frozen values must be written down BEFORE any performance number is calculated (ADV-M18-R02 qualifier) and every rule change afterwards is logged as new research (ADV-M18-R04)."
  },
